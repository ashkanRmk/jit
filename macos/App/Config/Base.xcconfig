// Shared build settings for the Jit app target (ADR-0003, ADR-0006 Phase 0 addendum).
#include "Version.xcconfig"
MACOSX_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
ARCHS = arm64
ENABLE_HARDENED_RUNTIME = YES
// Xcode omits the runtime flag for ad-hoc ("-") signing; force it so Phase 0 builds match release.
OTHER_CODE_SIGN_FLAGS = $(inherited) --options=runtime
ENABLE_APP_SANDBOX = NO
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
