# Non-secret release settings (ADR-0049). Identity-specific values go in scripts/release/release.local.env
# (git-ignored), e.g.:
#   JIT_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"
#   JIT_TEAM_ID=TEAMID
#   JIT_UPDATE_PUBLIC_KEY=<64 lowercase hex digits from update-signing.sh public-key>
# The version, build number, bundle ID and copyright come from macos/App/Config/Version.xcconfig only.
JIT_ARCHS="arm64"
JIT_NOTARY_PROFILE="jit-notary"
JIT_SIGN_IDENTITY=""
JIT_TEAM_ID=""
JIT_DMG_FORMAT="ULFO"

# Public pin for official releases. An environment override is useful for release rehearsals.
JIT_UPDATE_PUBLIC_KEY="${JIT_UPDATE_PUBLIC_KEY:-5229ff8184daeff6541e70bbf5f066e30bcf89dac4b159df0586be19e656579c}"
