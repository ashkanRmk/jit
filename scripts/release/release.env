# Non-secret release settings (ADR-0049). Identity-specific values go in scripts/release/release.local.env
# (git-ignored), e.g.:
#   JIT_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"
#   JIT_TEAM_ID=TEAMID
# The version, build number, bundle ID and copyright come from macos/App/Config/Version.xcconfig only.
JIT_ARCHS="arm64"
JIT_NOTARY_PROFILE="jit-notary"
JIT_SIGN_IDENTITY=""
JIT_TEAM_ID=""
JIT_DMG_FORMAT="ULFO"
